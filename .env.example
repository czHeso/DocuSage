# DocuSage – environment configuration
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored – never commit it.

# ============================================================
# REQUIRED
# ============================================================

# PostgreSQL connection string (Neon serverless or a regular Postgres)
DATABASE_URL=postgresql://user:password@host:5432/docusage?sslmode=require

# Which database driver to use: neon | postgres
# Leave empty – it is derived from DATABASE_URL (a *.neon.tech host uses the
# WebSocket driver, everything else uses a regular TCP connection).
DATABASE_DRIVER=

# Secret used to sign session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start without it. Never reuse the example value.
SESSION_SECRET=replace-me-with-a-long-random-string

# ============================================================
# SERVER
# ============================================================

# Port the application listens on.
# Azure App Service and Cloud Run provide the port themselves – leave it unset there.
PORT=5000
HOST=0.0.0.0

# development | production
NODE_ENV=development

# Public URL of the application – used in email links
# and as the default allowed CORS origin.
APP_URL=https://docusage.example.com

# ============================================================
# SECURITY
# ============================================================

# Origins allowed to call the API with the authentication cookie.
# Comma-separated, no trailing slash. Falls back to APP_URL if left empty.
# In development, localhost is allowed automatically.
# This does NOT restrict the public embed-widget endpoints – those must be
# reachable from any domain and authenticate with a project token, not a cookie.
ALLOWED_ORIGINS=https://docusage.example.com

# May anyone register themselves? Default false.
# The very first account in an empty database is always allowed and becomes admin.
ALLOW_PUBLIC_REGISTRATION=false

# Optional restriction of registration to specific email domains (comma-separated).
# Empty = no restriction.
ALLOWED_EMAIL_DOMAINS=

# Failed login attempts allowed per IP address within 15 minutes.
LOGIN_MAX_ATTEMPTS=10

# Maximum size of a JSON request body.
JSON_BODY_LIMIT=200kb

# Requests a single IP address may make to any /api endpoint per minute. The
# ceiling behind the tighter per-endpoint limits, so that no route is completely
# unlimited. The dashboard is chatty - opening a project fires a dozen or so
# requests at once - so this is well above normal use. Default 300.
API_RATE_LIMIT_PER_MINUTE=300

# Messages a single IP address may send to the embed chat endpoints per minute.
# The widget authenticates with a token that is visible in the page source of
# every site embedding it, so anyone can replay it - and every replay spends
# your provider credit. Default 20, which is far above a real conversation.
EMBED_RATE_LIMIT_PER_MINUTE=20

# Contact forms a single IP may submit per ten minutes. Much tighter, because
# nobody legitimately submits a contact form repeatedly and every submission is
# a database row and an email in somebody's inbox. Default 3.
LEAD_RATE_LIMIT_PER_10_MINUTES=3

# Hostnames allowed for the Vite development server (comma-separated).
# Only needed if you reach the dev server through a tunnel or custom domain.
VITE_ALLOWED_HOSTS=

# ============================================================
# SEARCH
# ============================================================

# Set to `off` to skip pgvector and compute vector similarity in the application
# process instead. Only useful for diagnosing a ranking difference – the answers
# are the same either way, the in-process path is just slower.
# Leave empty to use pgvector whenever the database has it.
SEARCH_PGVECTOR=

# ============================================================
# AI PROVIDERS (optional – can also be set per project in the UI)
# ============================================================

OPENAI_API_KEY=

# ============================================================
# EMAIL DELIVERY (optional)
# Without SMTP, account activation and password reset do not work.
# ============================================================

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="DocuSage" <noreply@example.com>

# ============================================================
# REGISTRATION PROTECTION (optional, Google reCAPTCHA)
# ============================================================

CAPTCHA_REQUIRED=false
CAPTCHA_SECRET_KEY=

# ============================================================
# DEBUGGING (optional)
# ============================================================

# Enables verbose authentication logging, including session IDs and the signed
# session cookie. Keep this off in production – anyone able to read the logs
# could replay a cookie and be logged in as that user.
DEBUG_AUTH=false

# Logs the full SMTP protocol conversation, including the AUTH exchange.
# Only for diagnosing delivery problems; never leave it on in production.
SMTP_DEBUG=false
